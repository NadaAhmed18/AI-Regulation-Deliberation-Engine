# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Neo4j (Week 1 knowledge base — required by src/agent/tools/retriever.py) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# --- Voyage AI embeddings (Week 1 — required by src/utils/embedder.py) ---
VOYAGE_API_KEY=your_voyage_api_key_here

# --- LLM provider (Week 2 — required by src/clients/llm_client.py) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Web search tool (this ticket — src/tools.py) ---
# If unset, search_web() returns a clear "unavailable" message and the
# agent is expected to fall back to search_ai_policy() instead of failing.
TAVILY_API_KEY=your_tavily_api_key_here
# ==============================================================================
# POSTGRESQL (Database for Langfuse & Discussion Engine)
# ==============================================================================
POSTGRES_USER="langfuse"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="langfuse"
# backend/ingestion-worker override this in docker-compose.yaml to point
# at "main" instead -- this value is only what Langfuse itself uses.
DATABASE_URL="postgresql://langfuse:your_postgres_password@postgres:5432/main"

# ==============================================================================
# CLICKHOUSE (Analytics DB for Langfuse)
# ==============================================================================
CLICKHOUSE_DB="default"
CLICKHOUSE_USER="clickhouse"
CLICKHOUSE_PASSWORD="your_clickhouse_password"
CLICKHOUSE_MIGRATION_URL="clickhouse://clickhouse:9000"
CLICKHOUSE_URL="http://clickhouse:8123"
CLICKHOUSE_CLUSTER_ENABLED="false"

# ==============================================================================
# REDIS (Caching & Queue for Langfuse)
# ==============================================================================
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_AUTH="your_redis_password"

# ==============================================================================
# MINIO (S3-Compatible Object Storage)
# ==============================================================================
MINIO_ROOT_USER="minio_admin"
MINIO_ROOT_PASSWORD="your_minio_password"

# ==============================================================================
# NEO4J (Graph Database & Vector Index)
# ==============================================================================
NEO4J_AUTH="neo4j/password123"
NEO4J_PLUGINS='["apoc"]'
# Split form of the same credential above -- the backend app's
# src/clients/neo4j.py reads these two separately rather than parsing
# NEO4J_AUTH's "user/pass" format. Keep both in sync.
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password123"

# ==============================================================================
# APPLICATION LAYER (backend + frontend containers)
# ==============================================================================
# What the user's BROWSER uses to reach the backend -- must be an
# externally-reachable host (your server's domain/IP for a real
# deployment), NOT the internal Docker service name "backend". Baked
# into the frontend's JS bundle at build time -- changing this requires
# rebuilding the frontend image, not just restarting the container.
FRONTEND_PUBLIC_BACKEND_HOST="localhost"
FRONTEND_PUBLIC_BACKEND_PORT="8000"

# ==============================================================================
# COMPUTE RESOURCE LIMITS (the "scaling knobs" -- see docker-compose.yaml)
# ==============================================================================
# Every value below has a sensible default already applied in
# docker-compose.yaml, so none of these need to be set to run the stack.
# Override only the ones you actually need to change, e.g. to give the
# backend more headroom for NLI/ingestion workloads:
#   BACKEND_CPUS=4
#   BACKEND_MEMORY=8g
#
# Each service's storage (its named volume) and compute (these limits)
# are independent -- bumping a *_MEMORY/*_CPUS value never touches that
# service's volume, and growing a volume never changes these limits on
# its own (Compose has no auto-scaling; see docker-compose.yaml's top
# comment).
#
# BACKEND_CPUS=2
# BACKEND_MEMORY=4g
# BACKEND_CPUS_RESERVED=1
# BACKEND_MEMORY_RESERVED=2g
# FRONTEND_CPUS=1
# FRONTEND_MEMORY=1g
# POSTGRES_CPUS=2
# POSTGRES_MEMORY=2g
# NEO4J_CPUS=2
# NEO4J_MEMORY=2g
# CLICKHOUSE_CPUS=1
# CLICKHOUSE_MEMORY=1g
# REDIS_CPUS=0.5
# REDIS_MEMORY=256m
# MINIO_CPUS=0.5
# MINIO_MEMORY=512m
# LANGFUSE_WEB_CPUS=1
# LANGFUSE_WEB_MEMORY=1g
# LANGFUSE_WORKER_CPUS=1
# LANGFUSE_WORKER_MEMORY=1g

# ==============================================================================
# INGESTION COMPUTE POOL (independent of backend/API compute -- see
# docker-compose.yaml's ingestion-worker service)
# ==============================================================================
# How many ingestion-worker containers to run. This is the actual
# "scale this independently" knob for ingestion throughput -- raise it
# when URLs are queuing up faster than they're being processed, without
# touching BACKEND_CPUS, any database, or any volume.
INGESTION_WORKER_REPLICAS=2
# How many ingestion jobs one worker container processes concurrently
# (Celery's --concurrency). Total ingestion concurrency across the
# whole pool = INGESTION_WORKER_REPLICAS * INGESTION_WORKER_CONCURRENCY.
INGESTION_WORKER_CONCURRENCY=2
# INGESTION_WORKER_CPUS=1
# INGESTION_WORKER_MEMORY=2g
# INGESTION_WORKER_CPUS_RESERVED=0.5
# INGESTION_WORKER_MEMORY_RESERVED=1g
# Which logical Redis DB index the Celery broker uses -- kept separate
# from Langfuse's own Redis usage (typically DB 0) so keys don't collide.
CELERY_BROKER_DB=1

# ==============================================================================
# LANGFUSE (Web & Worker Shared Configuration)
# ==============================================================================
SALT=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
ENCRYPTION_KEY=""

# S3 Event Upload Configuration for Langfuse
LANGFUSE_S3_EVENT_UPLOAD_BUCKET="langfuse"
LANGFUSE_S3_EVENT_UPLOAD_REGION="auto"
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID="minio_admin"
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=""
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT="http://minio:9000"
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE="true"
LANGFUSE_S3_EVENT_UPLOAD_PREFIX="events/"